    "seed:memberships": "node supabase/import/build-memberships.mjs",
    "seed:expand": "npm run seed:competitions && npm run seed:clubs-tm && npm run seed:import && npm run seed:memberships && npm run seed:gen",
    "seed:validate": "node supabase/validate-seed.mjs",
    "seed:gen": "node supabase/gen-seed-sql.mjs",
    "seed:sync": "node supabase/import/roster-sync.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.1",
