{
  "name": "sportslator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/verify-vercel-cron.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "seed:import": "node supabase/import/build-bulk.mjs",
    "seed:competitions": "node supabase/import/build-competitions.mjs",
